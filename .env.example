# ── ODDPool ────────────────────────────────────────────────────────
# Get your key at https://www.oddpool.com/settings (Premium plan)
ODDPOOL_API_KEY=your_oddpool_api_key_here

# ── Telegram alerts ────────────────────────────────────────────────
# 1. Create a bot with @BotFather → copy the token below
# 2. Start a chat with your bot (or add to a group)
# 3. Get your chat ID: curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456789:ABCdef-your-bot-token-here
TELEGRAM_CHAT_ID=your_chat_id_here
